# Backend environment (Render or local development)
NODE_ENV=production
PORT=5000

# Add the public website origin without a trailing slash.
SERVER_ALLOWED_ORIGINS=https://currentlylistening.vismaypatel.com
# Two or more long random strings separated by spaces.
SERVER_SESSION_KEYS=replace-with-long-random-secret-one replace-with-long-random-secret-two

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Obtain once with: node scripts/get-spotify-refresh-token.js
SPOTIFY_REFRESH_TOKEN=

# Optional lyrics / translation integrations
GENIUS_ACCESS_TOKEN=
GOOGLE_TRANSLATE_API_KEY=
